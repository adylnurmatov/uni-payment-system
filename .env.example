# Скопируйте в .env и заполните. Файл .env в git НЕ коммитится.

# fake — без сети и монет (по умолчанию), sepolia — настоящая тестовая сеть Ethereum
SPRING_PROFILES_ACTIVE=fake

# PostgreSQL (docker compose up -d postgres слушает localhost:5433)
DB_URL=jdbc:postgresql://localhost:5433/payments
DB_USER=payments
DB_PASSWORD=payments

# Ethereum Sepolia (нужно только для профиля sepolia).
# Публичные узлы: https://1rpc.io/sepolia, https://ethereum-sepolia-rpc.publicnode.com
# или бесплатный ключ Infura/Alchemy: https://sepolia.infura.io/v3/<KEY>
ETH_RPC_URL=https://1rpc.io/sepolia
ETH_CHAIN_ID=11155111

# Мастер-ключ шифрования приватных ключей кошельков: openssl rand -base64 32
# ВНИМАНИЕ: потеря этого ключа = потеря доступа ко всем кошелькам в БД.
WALLET_ENCRYPTION_KEY=

# Пароль администратора (Basic Auth для /api/admin, form login для /admin)
ADMIN_PASSWORD=

# Внешний «сервис ABC» (по умолчанию mock внутри приложения)
ABC_BASE_URL=http://localhost:8080/mock-abc

# Необязательно: сколько ETH давать новому мерчанту на комиссии (sepolia), таймаут подтверждения
# MERCHANT_INITIAL_FUNDING=0.005
# CONFIRMATION_TIMEOUT=10m

# Docker / сервер: порт приложения на хосте (на сервере удобно 80) и порт Postgres на localhost
# APP_PORT=8080
# POSTGRES_HOST_PORT=5433
